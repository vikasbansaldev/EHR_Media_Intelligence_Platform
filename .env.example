# Copy to .env and adjust. Every setting is optional; defaults are in src/ehr_intel/config.py.

# --- Paths ---------------------------------------------------------------
# EHR_RAW_DATA_DIR=data/raw
# EHR_VAR_DIR=var

# --- Ingestion -----------------------------------------------------------
# How to read ambiguous dates like 03/04/2024: "MDY" (US, default) or "DMY".
# EHR_DATE_ORDER=MDY

# --- Summarization (Task 3) ----------------------------------------------
# Leave unset to use the deterministic offline summarizer.
# ANTHROPIC_API_KEY=sk-ant-...
# EHR_SUMMARY_PROVIDER=auto        # auto | claude | rule_based
# EHR_CLAUDE_MODEL=claude-haiku-5-5
# EHR_SUMMARY_MAX_WORDS=200

# --- Search (Task 4) -----------------------------------------------------
# EHR_EMBEDDING_PROVIDER=auto      # auto | sentence_transformer | hashing
# EHR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EHR_SEARCH_TOP_K=5
# EHR_VECTOR_BACKEND=auto       # auto (FAISS if installed, else NumPy) | faiss | numpy

# --- API -----------------------------------------------------------------
# EHR_API_HOST=127.0.0.1
# EHR_API_PORT=8000
# EHR_CORS_ORIGINS=["http://localhost:8000"]
